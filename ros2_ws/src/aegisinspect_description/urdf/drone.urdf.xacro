<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aegis_drone">
  <!-- Sensor rig only. No flight dynamics, moving joints or dynamic TF. -->
  <link name="base_link">
    <visual><geometry><box size="0.4 0.4 0.12"/></geometry>
      <material name="body_gray"><color rgba="0.25 0.3 0.35 1"/></material>
    </visual>
  </link>
  <xacro:macro name="fixed_frame" params="parent child xyz rpy">
    <link name="${child}"/>
    <joint name="${parent}_to_${child}" type="fixed">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
  <xacro:fixed_frame parent="base_link" child="camera_link" xyz="0.25 0 0" rpy="0 0 0"/>
  <!-- Optical axes: +Z forward, +X right, +Y down. -->
  <xacro:fixed_frame parent="camera_link" child="camera_optical_frame"
                     xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  <xacro:fixed_frame parent="base_link" child="imu_link" xyz="0 0 0" rpy="0 0 0"/>
  <xacro:fixed_frame parent="base_link" child="lidar_link" xyz="0 0 0.15" rpy="0 0 0"/>
</robot>
