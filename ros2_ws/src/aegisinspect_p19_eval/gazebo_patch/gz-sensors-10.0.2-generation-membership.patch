diff --git a/src/CameraSensor.cc b/src/CameraSensor.cc
index bc0c88e..fa2e374 100644
--- a/src/CameraSensor.cc
+++ b/src/CameraSensor.cc
@@ -34,0 +35 @@
+#include <aegisinspect_p19_eval/sensor_batch_certificate.h>
@@ -641,0 +643,6 @@ void CameraSensor::PublishInfo(
+  auto calibration = this->dataPtr->infoMsg;
+  calibration.mutable_header()->clear_stamp();
+  const auto serializedCalibration = calibration.SerializeAsString();
+  const auto p19SensorIdentity = this->Name() + ":" + std::to_string(this->Id());
+  p19_record_calibration(p19SensorIdentity.c_str(),
+    serializedCalibration.data(), serializedCalibration.size());
