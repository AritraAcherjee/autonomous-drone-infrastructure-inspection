+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault('MPLCONFIGDIR', str(ROOT / 'outputs/cache/p19_matplotlib'))
+import numpy as np
+import matplotlib
