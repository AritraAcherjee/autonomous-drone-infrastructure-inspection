+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(Path(path).read_text(encoding='utf-8'))
+
+
+def write_json(path, value):
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    Path(path).write_bytes(canonical_json_bytes(value) + b'\n')
+
+
+def write_csv(path, rows):
+    with Path(path).open('w', newline='', encoding='utf-8') as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def read_csv(path):
+    with Path(path).open(newline='', encoding='utf-8') as stream:
+        return list(csv.DictReader(stream))
+
+
+def git(*args):
+    return subprocess.check_output(['git', '--no-optional-locks', *args], cwd=ROOT, text=True).strip()
+
+
+def integrity(config):
+    package = Path(config['package'])
+    archive = Path(config['zip'])
+    assert sha(archive) == config['expected_zip_sha256'], 'ZIP SHA mismatch'
+    extracted = package.parent
+    comparisons = []
+    with zipfile.ZipFile(archive) as z:
+        assert z.testzip() is None, 'ZIP CRC failure'
+        names = [i.filename for i in z.infolist() if not i.is_dir()]
+        assert len(names) == len(set(names)), 'Duplicate ZIP paths'
+        for name in names:
+            local = (extracted / name).resolve()
+            assert local.is_relative_to(extracted.resolve()), 'Unsafe ZIP path'
+            digest = hashlib.sha256(z.read(name)).hexdigest()
+            assert sha(local) == digest, f'ZIP/extracted mismatch: {name}'
+            comparisons.append({'path': name, 'sha256': digest, 'matches_extracted': True})
+        local_names = {f.relative_to(extracted).as_posix() for f in extracted.rglob('*') if f.is_file()}
+        assert local_names == set(names), 'ZIP/extracted inventory mismatch'
+    entries = []
+    for line in (package / 'SHA256SUMS.txt').read_text().splitlines():
+        digest, name = line.split('  ', 1)
+        local = (package / name).resolve()
+        assert local.is_relative_to(package.resolve()) and sha(local) == digest, name
+        entries.append({'path': name, 'sha256': digest, 'verified': True})
+    expected_names = {f.relative_to(package).as_posix() for f in package.rglob('*') if f.is_file() and f.name != 'SHA256SUMS.txt'}
+    assert len(entries) == len(expected_names) and {r['path'] for r in entries} == expected_names
+    metadata = read_json(package / 'exports/metadata.json')
+    sources = metadata['source_hashes']
+    for entry in sources:
+        assert sha(package / entry['evidence_copy']) == entry['sha256'], entry['evidence_copy']
+    assert metadata['branch'] == config['source_branch']
+    assert metadata['post_fix_commit'] == config['source_runtime_head']
+    assert metadata['dataset_complete'] and metadata['GT_evaluation_only']
+    assert metadata['safety']['P13_START_CALL_COUNT'] == 1
+    assert metadata['safety']['RESET_CALL_COUNT'] == 0
+    return {'zip_sha256': sha(archive), 'zip_crc_verified': True,
+            'zip_extracted_files': comparisons, 'source_manifest': entries,
+            'source_manifest_sha256': sha(package / 'SHA256SUMS.txt'),
+            'source_configuration_hashes_verified': sources}, metadata
+
+
+def load_trajectory(path, name, origin):
+    rows = read_csv(path)
+    assert len(rows) == {'canonical': 427, 'gt': 5670}[name]
+    expected_columns = 'timestamp_ns,timestamp_sec,relative_to_start_sec,px,py,pz,qx,qy,qz,qw,frame_id,child_frame_id,valid'.split(',')
+    assert list(rows[0]) == expected_columns
+    samples = []
+    for r in rows:
+        t = int(r['timestamp_ns'])
+        assert Decimal(r['timestamp_sec']) * 10**9 == t
+        assert Decimal(r['relative_to_start_sec']) * 10**9 == t - origin
+        assert r['valid'] == 'True'
+        assert r['frame_id'] == ('odom' if name == 'canonical' else 'world')
+        assert r['child_frame_id'] == ('base_link' if name == 'canonical' else '')
+        # GT PoseStamped has no child field. The frozen producer explicitly
+        # publishes worldPose(linkEntity_) named base_link (lines 519-524).
+        sample = p19.TrajectorySample(t, *(float(r[k]) for k in ['px','py','pz','qx','qy','qz','qw']), r['frame_id'], 'base_link')
+        samples.append(sample)
+    samples = p19.validate_trajectory(samples, expected_frame_id=('odom' if name == 'canonical' else 'world'), expected_child_frame_id='base_link')
+    norms = [sum(getattr(s,k)**2 for k in ['qx','qy','qz','qw'])**0.5 for s in samples]
+    ts = [s.timestamp_ns for s in samples]
+    return samples, {'path': str(path), 'sha256': sha(path), 'data_rows': len(rows),
+                     'columns': expected_columns, 'all_valid': True, 'strictly_increasing_timestamps': True,
+                     'first_timestamp_ns': ts[0], 'last_timestamp_ns': ts[-1],
+                     'minimum_gap_ns': min(np.diff(ts)).item(), 'maximum_gap_ns': max(np.diff(ts)).item(),
+                     'quaternion_norm_min': min(norms), 'quaternion_norm_max': max(norms),
+                     'timestamp_decimal_and_relative_columns_verified': True,
+                     'adapter': 'px,py,pz -> x_m,y_m,z_m; GT absent child -> base_link from frozen producer; no source edits'}
+
+
+def statistics(values, unit):
+    values = np.asarray(values, dtype=float)
+    return {'count': len(values), 'unit': unit, 'rmse': float(np.sqrt(np.mean(values**2))),
+            'mean': float(values.mean()), 'median': float(np.median(values)),
+            'p95': float(np.percentile(values, 95, method='linear')), 'max': float(values.max())}
+
+
+def pose_columns(prefix, sample):
+    return {prefix + k: getattr(sample, k) for k in ['x_m','y_m','z_m','qx','qy','qz','qw']}
+
+
+def plots(out):
+    """Render exclusively from persisted CSVs; record every plotted series."""
+    plt.rcParams.update({'font.family': 'DejaVu Sans', 'font.size': 10,
+                         'svg.hashsalt': 'p19-accepted-lidar-icp', 'axes.grid': True})
+    trajectory = read_csv(out / 'aligned_trajectory.csv')
+    ate = read_csv(out / 'per_sample_ate.csv')
+    series = []
+    plot_dir = out / 'plots'
+    plot_dir.mkdir(exist_ok=True)
+    label = 'Accepted LiDAR ICP run | primary +3 to +18 s (sim 38.763-53.763 s)'
+    def save(fig, name):
+        fig.savefig(plot_dir / (name+'.png'), dpi=180, metadata={'Software': 'P19 accepted LiDAR ICP evaluation'})
+        fig.savefig(plot_dir / (name+'.svg'), metadata={'Date': None, 'Creator': 'P19 accepted LiDAR ICP evaluation'})
+        plt.close(fig)
+    fig, axes = plt.subplots(1, 3, figsize=(15, 5), layout='constrained')
+    fig.suptitle(label+'\nRigid alignment to GT; scale fixed at 1')
+    for ax, (x, y) in zip(axes, [('x_m','y_m'), ('x_m','z_m'), ('y_m','z_m')]):
+        for prefix, title, color in [('est_aligned_', 'Aligned ICP', '#d55e00'), ('gt_', 'GT at estimator timestamps', '#0072b2')]:
+            xv = [float(r[prefix+x]) for r in trajectory]
+            yv = [float(r[prefix+y]) for r in trajectory]
+            ax.plot(xv, yv, '.-', ms=3, lw=1.2, label=title, color=color)
+            ax.scatter(xv[0], yv[0], marker='o', facecolors='none', edgecolors=color, s=65)
+            ax.scatter(xv[-1], yv[-1], marker='x', color=color, s=45)
+            for i, (xx, yy) in enumerate(zip(xv, yv)):
+                series.append({'plot': 'aligned_trajectory_vs_gt', 'panel': x+'_'+y, 'series': prefix,
+                               'source': 'aligned_trajectory.csv', 'row': i, 'x_column': prefix+x,
+                               'y_column': prefix+y, 'x': xx, 'y': yy})
+        ax.set(xlabel=x.replace('_m','')+' (m)', ylabel=y.replace('_m','')+' (m)', title='World frame; equal spatial scale')
+        ax.set_aspect('equal', adjustable='box')
+    axes[0].legend(loc='best', fontsize=8)
+    save(fig, 'aligned_trajectory_vs_gt')
+    for name, column, ylabel in [('translation_error_over_time','translation_error_m','Translation error (m)'),
+                                ('rotation_error_over_time','rotation_error_deg','Absolute orientation error (degrees)')]:
+        fig, ax = plt.subplots(figsize=(11, 5), layout='constrained')
+        x = [float(r['relative_to_start_s']) for r in ate]
+        y = [float(r[column]) for r in ate]
+        ax.plot(x, y, '.-', color='#d55e00', label='Aligned ICP versus interpolated GT')
+        ax.set(xlabel='Time from recorded START reference (s)', ylabel=ylabel, xlim=(3,18), ylim=(0,max(y)*1.08),
+               title=label + ('\nAbsolute orientation diagnostic; same position-fitted rigid transform' if 'rotation' in name else '\nPer-sample translation ATE'))
+        ax.legend(loc='best')
+        for i, (xx, yy) in enumerate(zip(x,y)):
+            series.append({'plot': name, 'panel': 'time', 'series': column, 'source': 'per_sample_ate.csv',
+                           'row': i, 'x_column': 'relative_to_start_s', 'y_column': column, 'x': xx, 'y': yy})
+        save(fig, name)
+    write_csv(out / 'plot_series.csv', series)
+    write_json(out / 'plot_provenance.json', {'sources': {n: sha(out/n) for n in ['aligned_trajectory.csv','per_sample_ate.csv','plot_series.csv']},
+        'formats': ['PNG 180 dpi','SVG'], 'spatial_axes': 'equal scale within each projection',
+        'error_axes': 'linear, zero-based; complete primary-window extent', 'no_smoothing_or_resampling': True,
+        'open_circle': 'first selected pose', 'cross': 'last selected pose',
+        'rotation_diagnostic': 'shortest absolute orientation angle after the same position-fitted SE(3); not RPE'})
+
